# Publish path
VITE_PUBLIC_PATH=/

# Cross-origin proxies
VITE_PROXY=[["/api","http://localhost:9580"],["/upload","http://localhost:9580"]]

# Full-path address of the backend interface (required)
VITE_GLOB_DOMAIN_URL=http://localhost:9580/

# Parent address of the backend interface (required)
VITE_GLOB_API_URL=/api

# Interface prefix
VITE_GLOB_API_URL_PREFIX=
