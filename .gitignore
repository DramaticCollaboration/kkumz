# =============================================================================
# 꿈즈 (Kkumz) .gitignore
# =============================================================================

# 1. OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 2. IDE & Editor Files
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
rebel.xml
.classpath
.project
.settings/
.factorypath
.apt_generated/
.cache/

# 3. Backend (Java / Maven / Spring Boot / JVM)
target/
!**/src/**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.flattened-pom.xml
!.mvn/wrapper/maven-wrapper.jar

# JVM Dumps & Logs
*.log
logs/
hs_err_pid*.log
replay_pid*.log
*.hprof
*.dump
dump.txt
derby.log

# 4. Frontend (Node.js / Vue 3 / Vite / Admin / Web)
node_modules/
node/
dist/
dist-ssr/
dist_bak/
!/admin/build/
!**/admin/build/
.pnpm/
.pnpm-store/
.local/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/
.quasar/
.nuxt/
.output/
*.tsbuildinfo

# 5. Environment & Sensitive Configs
/.env
.env.local
.env.*.local
.env.localsv
.local.env
*.local
!/.env.example
!**/.env.example
!**/.env.local.example
!admin/.env
!admin/.env.development
!admin/.env.production
!web/.env
!web/.env.development
!web/.env.production

# 6. Python, Test & QA Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
test-results/
playwright-report/
blob-report/
screenshots/
/upload/
/uploads/

# 7. Temporary, Scratch & Container Volume Data
*.bak
*.tmp
scratch/
docker-compose.override.yml
docker/postgres/data/
docker/redis/data/
/data/
